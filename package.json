{
  "name": "broadcast-event-logger",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typegen": "npx pocketbase-typegen --db ./pocketbase/pb_data/data.db -o ./src/lib/pocketbase/types.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.70.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/luxon": "^3.7.6",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "luxon": "^3.7.2",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "pocketbase": "^0.26.9"
  },
  "imports": {
