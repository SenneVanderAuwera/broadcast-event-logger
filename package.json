		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.0",
		"@types/luxon": "^3.7.1",
		"bits-ui": "^2.17.3",
		"clsx": "^2.1.1",
		"gsap": "^3.14.2",
		"luxon": "^3.7.2",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.53.1",
		"svelte-check": "^4.4.3",
